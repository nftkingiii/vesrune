# Optional read-only backend probe. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Publishable Pollar testnet key. Safe for the browser, but keep it local.
VITE_POLLAR_API_KEY=pub_testnet_replace_me

# Dedicated Stellar testnet recipient for the route's real USDC handoff.
# Must match server STELLAR_SETTLEMENT_WALLET and have a USDC trustline.
VITE_ROUTE_SETTLEMENT_WALLET=
